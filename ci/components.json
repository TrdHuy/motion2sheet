{
  "global_paths": [
    ".github/**",
    "ci/**",
    "pyproject.toml",
    "motion2sheet/__init__.py"
  ],
  "ignore_paths": [
    ".gitignore",
    "README.md",
    "docs/**",
    "sample/README.md"
  ],
  "components": {
    "motion-common": {"paths": ["motion2sheet/motion/common/**"], "depends_on": []},
    "motion-normalize": {"paths": ["motion2sheet/motion/normalize/**"], "depends_on": ["motion-common"]},
    "motion-retarget": {"paths": ["motion2sheet/motion/retarget/**", "motion2sheet/motion/profiles/**"], "depends_on": ["motion-common"]},
    "motion-render": {"paths": ["motion2sheet/motion/render/**"], "depends_on": ["motion-common"]},
    "motion-output": {"paths": ["motion2sheet/motion/output/**"], "depends_on": ["motion-common"]},
    "motion-extract": {"paths": ["motion2sheet/motion/extract/**"], "depends_on": ["motion-retarget"]},
    "motion-cli": {"paths": ["motion2sheet/motion/cli.py"], "depends_on": ["motion-extract", "motion-normalize", "motion-retarget", "motion-render", "motion-output"]},
    "sprite-workflow": {"paths": ["skills/**", "sample/sprite-generation/**"], "depends_on": []},
    "vfx-output": {"paths": ["motion2sheet/vfx2sheet/common/output/**"], "depends_on": []},
    "vfx-trajectory": {"paths": ["motion2sheet/vfx2sheet/common/trajectory/**", "profiles/vfx2sheet/trajectories/**"], "depends_on": []},
    "vfx-core": {"paths": ["motion2sheet/vfx2sheet/__init__.py", "motion2sheet/vfx2sheet/cli.py", "motion2sheet/vfx2sheet/registry.py", "motion2sheet/vfx2sheet/blender_entry.py"], "depends_on": ["vfx-output"]},
    "vfx-splash": {"paths": ["motion2sheet/vfx2sheet/effects/splash/**", "profiles/vfx2sheet/splash/**"], "depends_on": ["vfx-core", "vfx-output", "vfx-trajectory"]},
    "anim-common": {"paths": ["motion2sheet/anim2sheet/common/**", "profiles/anim2sheet/cameras/**", "profiles/anim2sheet/rigs/**", "profiles/anim2sheet/characters/**"], "depends_on": []},
    "anim-core": {"paths": ["motion2sheet/anim2sheet/__init__.py", "motion2sheet/anim2sheet/cli.py", "motion2sheet/anim2sheet/registry.py", "motion2sheet/anim2sheet/blender_entry.py"], "depends_on": ["anim-common"]},
    "anim-gale-slash": {"paths": ["profiles/anim2sheet/animations/gale_slash/**"], "depends_on": ["anim-core"]},
    "anim-sword-idle": {"paths": ["profiles/anim2sheet/animations/sword_idle/**"], "depends_on": ["anim-core"]}
  },
  "test_targets": {
    "motion-normalize-unit": {"kind": "unit", "path": "tests/motion/normalize/test_normalize.py", "paths": ["tests/motion/normalize/**"], "depends_on": ["motion-normalize"]},
    "motion-retarget-unit": {"kind": "unit", "path": "tests/motion/retarget/test_retarget.py", "paths": ["tests/motion/retarget/**"], "depends_on": ["motion-retarget"]},
    "motion-render-unit": {"kind": "unit", "path": "tests/motion/render/test_renderer.py", "paths": ["tests/motion/render/**"], "depends_on": ["motion-render"]},
    "motion-output-unit": {"kind": "unit", "path": "tests/motion/output/test_validator.py", "paths": ["tests/motion/output/test_validator.py"], "depends_on": ["motion-output"]},
    "motion-output-mode-unit": {"kind": "unit", "path": "tests/motion/output/test_output_mode.py", "paths": ["tests/motion/output/test_output_mode.py"], "depends_on": ["motion-cli"]},
    "motion-synthetic-fbx": {"kind": "motion-e2e", "target": "synthetic-fbx", "paths": ["tests/motion/fixtures/**", "tests/motion/e2e/verify_generated_output.py", "tests/motion/e2e/verify_retarget_output.py"], "depends_on": ["motion-cli"]},
    "motion-synthetic-bvh": {"kind": "motion-e2e", "target": "synthetic-bvh", "paths": ["tests/motion/fixtures/**", "tests/motion/e2e/verify_generated_output.py", "tests/motion/e2e/verify_retarget_output.py"], "depends_on": ["motion-cli"]},
    "motion-mixamo-real": {"kind": "motion-e2e", "target": "mixamo-real", "paths": ["tests/motion/e2e/verify_mixamo_output.py", "sample/walk_mixamo.fbx"], "depends_on": ["motion-cli"]},
    "motion-output-mode-e2e": {"kind": "motion-e2e", "target": "output-mode", "paths": ["tests/motion/e2e/verify_output_mode.py"], "depends_on": ["motion-cli"]},
    "sprite-workflow-contract": {"kind": "unit", "path": "tests/sprite_workflow/test_single_frame_contract.py", "paths": ["tests/sprite_workflow/**"], "depends_on": ["sprite-workflow"]},
    "vfx-unit": {"kind": "unit", "path": "tests/vfx2sheet/unit", "paths": ["tests/vfx2sheet/unit/**"], "depends_on": ["vfx-splash"]},
    "vfx-splash-e2e": {"kind": "vfx-e2e", "target": "splash", "paths": ["tests/vfx2sheet/e2e/**", "tests/vfx2sheet/fixtures/splash/**", "tests/vfx2sheet/golden/splash/**"], "depends_on": ["vfx-splash"]},
    "anim-common-unit": {"kind": "unit", "path": "tests/anim2sheet/common", "paths": ["tests/anim2sheet/common/**"], "depends_on": ["anim-common"]},
    "anim-cli-unit": {"kind": "unit", "path": "tests/anim2sheet/cli", "paths": ["tests/anim2sheet/cli/**"], "depends_on": ["anim-core", "anim-gale-slash", "anim-sword-idle"]},
    "anim-gale-slash-unit": {"kind": "unit", "path": "tests/anim2sheet/animations/gale_slash/unit", "paths": ["tests/anim2sheet/animations/gale_slash/unit/**"], "depends_on": ["anim-gale-slash"]},
    "anim-sword-idle-unit": {"kind": "unit", "path": "tests/anim2sheet/animations/sword_idle/unit", "paths": ["tests/anim2sheet/animations/sword_idle/unit/**"], "depends_on": ["anim-sword-idle"]},
    "anim-gale-slash-e2e": {"kind": "anim-e2e", "target": "gale_slash", "paths": ["tests/anim2sheet/animations/gale_slash/e2e/**", "tests/anim2sheet/common/authority/**"], "depends_on": ["anim-gale-slash"]},
    "anim-sword-idle-e2e": {"kind": "anim-e2e", "target": "sword_idle", "paths": ["tests/anim2sheet/common/authority/**"], "depends_on": ["anim-sword-idle"]},
    "ci-affected-unit": {"kind": "unit", "path": "tests/ci/test_detect_affected.py", "paths": ["tests/ci/**"], "depends_on": []}
  }
}
