{
  version: 1,
  name: "GameHumanoidV2",
  authoringCapability: "humanoid_v2",
  rootObject: "MotionRoot",
  rotationMode: "XYZ",
  coordinateSystem: {
    space: "world",
    x: "screen-right",
    y: "depth; negative is toward camera",
    z: "up",
    units: "Blender meters",
  },
  restPose: {
    assumptions: [
      "bone local +Y follows head-to-tail",
      "character faces camera-space down by default",
      "shoulders derive from Chest -> Clavicle -> UpperArm hierarchy",
    ],
    bones: [
      { name: "Root", head: [0,0,0.84], tail: [0,0,0.96], deform: false },
      { name: "Pelvis", head: [0,0,0.96], tail: [0,0,1.12], parent: "Root", connected: true },
      { name: "Spine", head: [0,0,1.12], tail: [0,0,1.34], parent: "Pelvis", connected: true },
      { name: "Chest", head: [0,0,1.34], tail: [0,0,1.56], parent: "Spine", connected: true },
      { name: "Neck", head: [0,0,1.56], tail: [0,0,1.70], parent: "Chest", connected: true },
      { name: "Head", head: [0,0,1.70], tail: [0,0,1.94], parent: "Neck", connected: true },
      { name: "LeftClavicle", head: [0,0,1.53], tail: [-0.18,0,1.53], parent: "Chest" },
      { name: "LeftUpperArm", head: [-0.18,0,1.53], tail: [-0.48,0,1.42], parent: "LeftClavicle", connected: true },
      { name: "LeftForeArm", head: [-0.48,0,1.42], tail: [-0.72,0,1.24], parent: "LeftUpperArm", connected: true },
      { name: "LeftHand", head: [-0.72,0,1.24], tail: [-0.82,0,1.17], parent: "LeftForeArm", connected: true },
      { name: "RightClavicle", head: [0,0,1.53], tail: [0.18,0,1.53], parent: "Chest" },
      { name: "RightUpperArm", head: [0.18,0,1.53], tail: [0.48,0,1.42], parent: "RightClavicle", connected: true },
      { name: "RightForeArm", head: [0.48,0,1.42], tail: [0.72,0,1.24], parent: "RightUpperArm", connected: true },
      { name: "RightHand", head: [0.72,0,1.24], tail: [0.82,0,1.17], parent: "RightForeArm", connected: true },
      { name: "LeftHip", head: [0,0,1.03], tail: [-0.17,0,0.96], parent: "Pelvis", deform: false },
      { name: "LeftThigh", head: [-0.17,0,0.96], tail: [-0.23,0,0.56], parent: "LeftHip", connected: true },
      { name: "LeftShin", head: [-0.23,0,0.56], tail: [-0.30,0,0.14], parent: "LeftThigh", connected: true },
      { name: "LeftFoot", head: [-0.30,0,0.14], tail: [-0.30,-0.24,0.07], parent: "LeftShin", connected: true },
      { name: "RightHip", head: [0,0,1.03], tail: [0.17,0,0.96], parent: "Pelvis", deform: false },
      { name: "RightThigh", head: [0.17,0,0.96], tail: [0.23,0,0.56], parent: "RightHip", connected: true },
      { name: "RightShin", head: [0.23,0,0.56], tail: [0.30,0,0.14], parent: "RightThigh", connected: true },
      { name: "RightFoot", head: [0.30,0,0.14], tail: [0.30,-0.24,0.07], parent: "RightShin", connected: true },
    ],
  },
  semantics: {
    root: "Root", pelvis: "Pelvis", spine: "Spine", chest: "Chest", neck: "Neck", head: "Head",
    leftClavicle: "LeftClavicle", rightClavicle: "RightClavicle",
  },
  targets: [
    { semantic: "leftWrist", object: "LeftWristTarget" },
    { semantic: "rightWrist", object: "RightWristTarget" },
    { semantic: "leftAnkle", object: "LeftAnkleTarget" },
    { semantic: "rightAnkle", object: "RightAnkleTarget" },
    { semantic: "leftElbowGuide", object: "LeftElbowGuideTarget" },
    { semantic: "rightElbowGuide", object: "RightElbowGuideTarget" },
    { semantic: "leftKneeGuide", object: "LeftKneeGuideTarget" },
    { semantic: "rightKneeGuide", object: "RightKneeGuideTarget" },
  ],
  solvers: {
    torso: {
      mode: "fk_with_body_overrides",
      yawAxis: "Y",
      leanAxis: "Z",
      leanSign: -1,
      bodyChannels: [
        { bone: "Pelvis", yawField: "pelvisYawDeg", leanField: "pelvisLeanDeg" },
        { bone: "Spine", yawField: "spineYawDeg", leanField: "spineLeanDeg" },
        { bone: "Chest", yawField: "chestYawDeg", leanField: "chestLeanDeg" },
        { bone: "Head", yawField: "headYawDeg", leanField: "headLeanDeg" },
      ],
      clavicleChannels: [
        { bone: "LeftClavicle", field: "leftClavicleSwingDeg", axis: "Z", sign: 1 },
        { bone: "RightClavicle", field: "rightClavicleSwingDeg", axis: "Z", sign: -1 },
      ],
      overrideFields: [
        "pelvisYawDeg", "pelvisLeanDeg", "spineYawDeg", "spineLeanDeg",
        "chestYawDeg", "chestLeanDeg", "leftClavicleSwingDeg", "rightClavicleSwingDeg",
      ],
    },
    arms: {
      mode: "deterministic_joint_fk",
      localBoneAxis: "+Y",
      sides: {
        left: {
          upperBone: "LeftUpperArm", foreBone: "LeftForeArm", handBone: "LeftHand",
          ikConstraint: "ReferenceIK_LeftForeArm",
          elbowPoseField: "leftElbow", wristPoseField: "leftWrist",
        },
        right: {
          upperBone: "RightUpperArm", foreBone: "RightForeArm", handBone: "RightHand",
          ikConstraint: "ReferenceIK_RightForeArm",
          elbowPoseField: "rightElbow", wristPoseField: "rightWrist",
        },
      },
    },
    legs: {
      mode: "ik_with_explicit_knee_poles",
      sides: {
        left: {
          thighBone: "LeftThigh", shinBone: "LeftShin", ikConstraint: "ReferenceIK_LeftShin",
          ankleTarget: "leftAnkle", kneeGuideTarget: "leftKneeGuide", poleAngleDeg: 0,
        },
        right: {
          thighBone: "RightThigh", shinBone: "RightShin", ikConstraint: "ReferenceIK_RightShin",
          ankleTarget: "rightAnkle", kneeGuideTarget: "rightKneeGuide", poleAngleDeg: 180,
        },
      },
      overrideTargets: ["leftAnkle", "rightAnkle", "leftKneeGuide", "rightKneeGuide"],
    },
    ikChains: [
      { bone: "LeftForeArm", target: "leftWrist", guide: "leftElbowGuide", constraint: "ReferenceIK_LeftForeArm", chainCount: 2, iterations: 64 },
      { bone: "RightForeArm", target: "rightWrist", guide: "rightElbowGuide", constraint: "ReferenceIK_RightForeArm", chainCount: 2, iterations: 64 },
      { bone: "LeftShin", target: "leftAnkle", guide: "leftKneeGuide", constraint: "ReferenceIK_LeftShin", chainCount: 2, iterations: 64 },
      { bone: "RightShin", target: "rightAnkle", guide: "rightKneeGuide", constraint: "ReferenceIK_RightShin", chainCount: 2, iterations: 64 },
    ],
  },
}
